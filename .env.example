# ==========================================
# CarFlow SaaS - Environment Configuration
# ==========================================
# Copy this file to .env and update values

# ==========================================
# Server Configuration
# ==========================================
PORT=8080

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=carflow
DB_PASSWORD=carflow123
DB_NAME=carflow
DB_SSLMODE=disable

# For Docker Compose, use:
# DB_HOST=postgres

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# For Docker Compose, use:
# REDIS_HOST=redis

# ==========================================
# Authentication & Security
# ==========================================
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration (in hours)
JWT_EXPIRATION_HOURS=24

# Bcrypt cost (10-12 recommended)
BCRYPT_COST=10

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=20

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# Stripe Configuration (Payment Processing)
# ==========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs for subscription plans
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# ==========================================
# Brevo Configuration (Email Service)
# ==========================================
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@carflow.com
BREVO_SENDER_NAME=CarFlow

# ==========================================
# Application Settings
# ==========================================
# Environment: development, staging, production
APP_ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable debug mode (verbose logging)
DEBUG=false

# ==========================================
# Trial & Subscription Defaults
# ==========================================
DEFAULT_TRIAL_DAYS=14
DEFAULT_SUBSCRIPTION_PLAN=starter

# ==========================================
# Usage Limits (Default for Starter Plan)
# ==========================================
LIMIT_MAX_VEHICLES=100
LIMIT_MAX_USERS=3
LIMIT_MAX_API_CALLS_PER_MONTH=10000

# ==========================================
# Feature Flags
# ==========================================
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_AUDIT_LOGS_ENABLED=true
FEATURE_EMAIL_NOTIFICATIONS_ENABLED=true

# ==========================================
# Monitoring & Observability
# ==========================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Enable Prometheus metrics endpoint
PROMETHEUS_ENABLED=false

# ==========================================
# External Services
# ==========================================
# Twilio for SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================================
# Development Only
# ==========================================
# Seed database with demo data
SEED_DEMO_DATA=true

# Auto-run migrations on startup
AUTO_MIGRATE=true
